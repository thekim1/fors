{
  // Owned by the Ume.Rag platform (github.com/thekim1/ume-rag-platform): change its keys and scopes here, not in gateway code.
  // A preset is an integration manifest (docs/integrations.md, "Provisioning from a manifest") with a title; the admin
  // console lets you edit it, for example an address list, before anything is created. It names no owner, so Ume.Rag is
  // placed in a team and department of its own (code "ume-rag"), which a gateway admin can move to the organisation's
  // own team under Integrations; add an "owner" to place it in an existing team at once.
  "schemaVersion": 1,
  "preset": {
    "title": "Ume.Rag",
    "description": "Retrieval (RAG) platform: rag-api serves chat, rag-admin reads the organisation and usage, rag-worker indexes; every key on-premises or EU models only."
  },
  "integration": {
    "name": "Ume.Rag",
    "description": "Ume.Rag retrieval platform"
  },
  "credentialKeys": [
    { "name": "rag-api", "allowedResidencies": ["OnPrem", "Eu"], "requireMaxResidency": true, "piiPolicy": "Off", "allowedIpRanges": [] },
    { "name": "rag-admin", "integrationScopes": ["organisation.read", "usage.read"], "allowedResidencies": ["OnPrem", "Eu"], "requireMaxResidency": true, "piiPolicy": "Off", "allowedIpRanges": [] },
    { "name": "rag-worker", "allowedResidencies": ["OnPrem", "Eu"], "requireMaxResidency": true, "piiPolicy": "Off", "allowedIpRanges": [] }
  ]
}
