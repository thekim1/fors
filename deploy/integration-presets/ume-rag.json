{
  // Owned by the Ume.Rag platform (github.com/thekim1/ume-rag-platform): change its keys and scopes here, not in gateway code.
  // A preset is an integration manifest (docs/integrations.md, "Provisioning from a manifest") with a title; the admin
  // console lets you edit it, for example the owner team or an address list, before anything is created.
  "schemaVersion": 1,
  "preset": {
    "title": "Ume.Rag",
    "description": "Retrieval (RAG) platform: rag-api serves chat, rag-admin reads the organisation and usage, rag-worker indexes with on-premises or EU models only."
  },
  "integration": {
    "name": "Ume.Rag",
    "description": "Ume.Rag retrieval platform",
    "owner": { "teamCode": "ume-rag", "teamName": "Ume.Rag", "departmentCode": "", "departmentName": "" }
  },
  "credentialKeys": [
    { "name": "rag-api", "requireMaxResidency": true, "piiPolicy": "Off", "allowedIpRanges": [] },
    { "name": "rag-admin", "integrationScopes": ["organisation.read", "usage.read"], "requireMaxResidency": true, "piiPolicy": "Off", "allowedIpRanges": [] },
    { "name": "rag-worker", "allowedResidencies": ["OnPrem", "Eu"], "requireMaxResidency": true, "piiPolicy": "Off", "allowedIpRanges": [] }
  ]
}
